{
  "denyPaths": [".next/**", "node_modules/**", "pnpm-lock.yaml", "test-results/**", "playwright-report/**"],
  "askPaths": ["vault/**"],

  "lint": [
    {
      "match": "\\.(tsx|jsx|ts|css)$",
      "$comment": [
        "design-lint.test.ts is excluded because it tests the linter BY EXECUTION: it holds",
        "#6366f1, a display face, 4px type and var(--ink-2) as string fixtures. Linting it",
        "reports two dozen violations that are every one of them the point of the file, and a",
        "guardrail that cries wolf on one file is one people learn to ignore everywhere."
      ],
      "exclude": "node_modules/|design-lint.test.ts$",
      "command": "node scripts/blueprint-lint.js"
    },
    {
      "match": "\\.(ts|tsx|js|jsx|mjs)$",
      "exclude": "node_modules/",
      "command": "node scripts/fs-boundary.js"
    }
  ],

  "stopChecks": [
    {
      "match": "^(lib|app|components|tests)[/\\\\]",
      "command": "pnpm exec vitest run",
      "label": "unit tests",
      "timeoutMs": 180000
    },
    {
      "match": "\\.(ts|tsx)$",
      "command": "pnpm exec tsc --noEmit",
      "label": "typecheck",
      "timeoutMs": 180000
    }
  ],

  "verify": [
    { "command": "pnpm exec tsc --noEmit", "label": "typecheck" },
    { "command": "pnpm exec eslint .", "label": "lint" },
    { "command": "pnpm exec vitest run", "label": "unit tests" },
    { "command": "pnpm exec playwright test", "label": "e2e" }
  ]
}
